{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowTasksTableAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:Scan",
        "dynamodb:Query",
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:ap-south-2:ACCOUNT_ID:table/Tasks",
        "arn:aws:dynamodb:ap-south-2:ACCOUNT_ID:table/Tasks/index/*"
      ]
    }
  ]
}
